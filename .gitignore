# Paper 2 corpora: public data, but large and re-fetchable by script
data/paper2/*.json

# Paper 2 braille export: regenerated by scripts/export_paper2_dataset.py,
# and its size is the point of publishing it to a dataset host rather than here
data/paper2_dataset/*.jsonl

# Built by scripts/build_catalog_db.py from data/paper2_dataset; 363 MB and
# fully derived, so it is rebuilt rather than committed
data/catalog.db
data/catalog.db.tmp
